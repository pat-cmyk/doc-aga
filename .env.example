# Doc Aga — environment variables (frontend / Vite)
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored and must
# never be committed. The Supabase keys below are the PUBLIC (anon / publishable)
# keys and are safe to ship in the frontend bundle, but we still keep the file
# untracked so local overrides and any future secrets never leak.
#
# In production these are managed by Lovable Cloud — do not hand-edit the
# deployed `.env`.

# --- Supabase (public, frontend) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key

# Some tooling/scripts read the non-prefixed variants:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key

# --- Cloudflare Turnstile (public site key, frontend) ---
# Bot protection on public forms (merchant signup, farmer feedback). If unset,
# the Turnstile widget is skipped (forms still work) — set it to enforce.
# Use the Cloudflare test key 1x00000000000000000000AA for local development.
VITE_TURNSTILE_SITE_KEY=

# -----------------------------------------------------------------------------
# Edge-function secrets (NOT loaded from this file — set in Supabase / Lovable
# Cloud project secrets). Listed here for documentation only:
#
#   ALLOWED_ORIGINS   Comma-separated CORS allowlist, e.g.
#                     https://doc-aga.goldenforage.com,https://your-preview.lovable.app
#   TURNSTILE_SECRET  Cloudflare Turnstile secret key (server-side verification)
#   LOVABLE_API_KEY   Lovable AI gateway key (auto-managed by Lovable)
#   SUPABASE_SERVICE_ROLE_KEY  Service role key (auto-managed)
#   WEBHOOK_SECRET    HMAC secret for CI test-result webhook
# -----------------------------------------------------------------------------

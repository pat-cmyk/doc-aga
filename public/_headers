# Security headers for the web deployment.
# Netlify / Cloudflare Pages / Lovable-style `_headers` file. This file is copied
# verbatim into dist/ at build time and applied by the static host.
#
# NOTE: Capacitor (Android/iOS) loads the bundle from the local filesystem with no
# HTTP layer, so these response headers do not apply there. CSP for native is
# shipped as a <meta> baked into index.html at build time (see vite.config.ts).
# Keep the Content-Security-Policy below in sync with CSP_META in vite.config.ts.
#
# CSP source allowances:
#   supabase.co (REST + wss realtime), ai.gateway.lovable.dev (Lovable AI),
#   api.elevenlabs.io + wss (voice), api/events/*.tiles.mapbox.com (maps),
#   challenges.cloudflare.com (Turnstile), Google Fonts, gstatic connectivity probe.
#   'unsafe-inline' style + blob:/worker-src are required by Radix/shadcn,
#   Mapbox GL workers, and the PWA service worker.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(self), microphone=(self), camera=(self), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://*.lovable.app https://*.lovable.dev; form-action 'self'; manifest-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://ai.gateway.lovable.dev https://api.elevenlabs.io wss://api.elevenlabs.io https://api.mapbox.com https://events.mapbox.com https://*.tiles.mapbox.com https://connectivitycheck.gstatic.com https://fonts.googleapis.com https://fonts.gstatic.com; upgrade-insecure-requests
